graph TB
  User(["Clone it and run it<br/>single user, self-hosted"])

  subgraph Client["Browser"]
    UI["React + Vite<br/>CV Editor · Job Board · Tracker"]
  end

  subgraph Server["API — Node · Express · Prisma"]
    Routes["HTTP routes<br/>CV · jobs · tracker"]
    Engine["Visibility + pitch engine<br/>one master CV, many named variants<br/>the master is never mutated"]
    Registry["Job source registry<br/>adapters behind one interface"]
  end

  subgraph State["State, all on your machine"]
    Postgres[("Postgres<br/>MasterCv · CvProfile · CvRender<br/>Application · JobListing")]
    Archive["PDF archive<br/>one file per render, never overwritten"]
  end

  Renderer["Headless browser<br/>any Chromium-compatible binary<br/>set via CHROMIUM_BIN"]
  LLM["Ollama — optional<br/>local model, no API key, no metering"]
  Scraper["python-jobspy subprocess<br/>the one non-TypeScript piece"]
  Indeed(["Indeed"])

  User --> UI
  UI -->|"HTTP · JSON<br/>/api proxied to the API"| Routes

  Routes --> Engine
  Routes --> Registry
  Routes -.->|"suggests toggles, never applies them<br/>a human confirms every change"| LLM

  Engine --> Postgres
  Engine -->|"resolve the variant, then render"| Renderer
  Renderer --> Archive
  Renderer -->|"immutable receipt: the resolved<br/>CV, hashed and frozen"| Postgres

  Registry --> Scraper
  Scraper ==>|"the only call that leaves your machine"| Indeed

  classDef ext fill:#fff4e5,stroke:#b45309,stroke-width:2px,color:#7c3d00
  classDef opt fill:#f7faf9,stroke:#63666b,stroke-dasharray: 5 5,color:#14151a
  class Indeed,Scraper ext
  class LLM opt
