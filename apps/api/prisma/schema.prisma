// Prisma schema for the job-hunt app.
//
// Every model carries `userId` (defaulted to "local" for the single-user
// MVP) so the later multi-user migration (see plan Phase 3) is additive —
// add an auth layer and start populating real user ids, no schema rewrite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id          String    @id @default(cuid())
  userId      String    @default("local")
  dateApplied DateTime?
  company     String
  role        String
  location    String?
  source      String? // company_site | linkedin_easy_apply | platform | ...
  foundVia    String? // gmail | linkedin_export | manual | ...
  atsPlatform String?
  cvVersion   String?
  coverLetter String?
  status      String    @default("applied") // applied | interview | offer | rejected
  responseDate DateTime?
  responseType String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model JobListing {
  id         String   @id @default(cuid())
  userId     String   @default("local")
  firstSeen  DateTime @default(now())
  status     String   @default("new") // new | shortlist | skip | applied
  title      String
  company    String
  location   String?
  country    String?
  site       String // indeed | careeros | linkedin
  datePosted DateTime?
  jobUrl     String   @unique
  notes      String?

  @@index([userId])
  @@index([site])
}

model MasterCv {
  id        String      @id @default(cuid())
  userId    String      @default("local")
  name      String // e.g. "master"
  data      Json // rxresume-style CV schema (see apps/api/src/cv/schema.ts)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  profiles  CvProfile[]

  @@unique([userId, name])
}

model CvProfile {
  id         String   @id @default(cuid())
  userId     String   @default("local")
  masterCvId String
  masterCv   MasterCv @relation(fields: [masterCvId], references: [id], onDelete: Cascade)
  name       String // e.g. "Corporate", "Startup", "NGO" — user-defined
  visibility Json // { [sectionId]: boolean, [itemId]: boolean } overrides
  order      Json // string[] of section keys, mirrors render_cv.py's --order
  style      String   @default("default") // default | compact
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([masterCvId, name])
}
